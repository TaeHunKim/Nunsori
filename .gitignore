# Build / IDE
*.iml
.gradle/
.idea/
/build/
**/build/
/captures/
.externalNativeBuild/
.cxx/
/local.properties
.DS_Store

# Models and databases (large, downloaded at runtime)
*.gguf
*.tflite
*.onnx
*.litertlm
*.task
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.xnnpack_cache

# Test fixtures: images are generated/downloaded, not committed (see scripts/fetch-photo-fixtures.sh, make-text-fixtures.py)
/test-fixtures/images/*
!/test-fixtures/images/.gitkeep
/test-fixtures/docs/*
/test-fixtures/media/*
*.jpg
*.jpeg
*.png
*.webp
*.heic

# Third-party binaries fetched by scripts (see scripts/fetch-sherpa-onnx.sh)
/app/libs/*.aar
/app/src/main/assets/*.onnx

# Local Claude Code state
.claude/settings.local.json
