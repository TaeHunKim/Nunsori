<!-- Launcher icon foreground: a round, friendly eye (눈) whose iris holds sound bars (소리). Inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- eye: a soft ellipse, no pointed corners -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M26,54a28,23 0,1 0,56 0a28,23 0,1 0,-56 0" />
    <!-- iris -->
    <path
        android:fillColor="#FF4C5BD6"
        android:pathData="M54,54m-14,0a14,14 0,1 1,28 0a14,14 0,1 1,-28 0" />
    <!-- sound bars -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M47.5,51 L47.5,57 M54,46.5 L54,61.5 M60.5,51 L60.5,57" />
    <!-- little highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M62,45m-2.6,0a2.6,2.6 0,1 1,5.2 0a2.6,2.6 0,1 1,-5.2 0" />
</vector>
